vec2 :: [2]f32
vec4 :: [4]f32

Item :: struct #align(16) {
	v: f32,
}

Data :: struct #align(16) {
	color: [4]f32,
	items: []Item,
	n: i32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	uv: [2]f32,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	sum: f32 = 0

	for i in 0..<data.n {
		_ = i
		sum += 1
	}

	for i in 0..=3 {
		_ = i
	}

	for x in data.items {
		sum += x.v
	}

	for x, i in data.items {
		_ = i
		sum += x.v
	}

	_ = sum
	out.pos = vec4(0, 0, 0, 1)
	out.uv = vec2(0, 0)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	out = data.color
	return out
}
