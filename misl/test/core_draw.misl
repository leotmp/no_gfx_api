import "core:draw.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	p := vec2(0.1, 0.2)
	_ = draw.circle(p, 0.3)
	_ = draw.rect(p, vec2(0.2, 0.1))
	_ = draw.line(p, vec2(0, 0), vec2(1, 0.2))
	_ = draw.tri(p, 0.4)
	_ = draw.hex(p, 0.3)
	_ = draw.arrow(p, vec2(0, 0), vec2(0.5, 0.1), 0.1)
	_ = draw.axis2(p, 0.5)
	_ = draw.digit(p, 7)
	_ = draw.fill(0.1, 0.01)
	_ = draw.stroke(0.1, 0.02, 0.005)
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	out = data.color
	return out
}
