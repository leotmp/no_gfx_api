import "core:distort.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
	tex: t32_2d,
	samp: s32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	uv := vec2(0.5, 0.5)
	_ = distort.barrel(uv, 0.2)
	_ = distort.pincushion(uv, 0.2)
	_ = distort.stretch(uv, vec2(1.1, 0.9))
	_ = distort.displace(uv, vec2(0.4, 0.6), 0.05)
	_ = distort.grain(uv, 0.1, 0)
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	uv := vec2(0.5, 0.5)
	_ = distort.chromatic_aberration(data.tex, data.samp, uv, 0.04)
	out = data.color
	return out
}
