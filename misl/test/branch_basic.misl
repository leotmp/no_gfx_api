vec2 :: [2]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
	limit: i32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	uv: [2]f32,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	for i: i32 = 0; i < data.limit; i += 1 {
		if i == 2 {
			continue
		}
		if i == 5 {
			break
		}
	}

	// if-with-init
	if n := data.limit; n > 0 {
		_ = n
	}

	out.pos = vec4(0, 0, 0, 1)
	out.uv = vec2(0, 0)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	if fsin.uv.x < 0 {
		discard
	}
	out = data.color
	return out
}
