vec2 :: [2]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	uv:  [2]f32,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	out.uv = vec2(0, 0)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	r := 'A'
	c: rune = 10
	x := 'A' + 10
	digit: u32 = 3
	ch := '0' + digit
	as_u8: u8 = 'A'
	as_u32 := u32(r)
	out = data.color
	out.x = f32(u32(x) + u32(c) + u32(ch) + u32(as_u8) + as_u32)
	return out
}
