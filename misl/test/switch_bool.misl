// Conditionless switch { case <bool>: … } → GLSL if / else-if chain (first true wins).
vec4 :: [4]f32

Data :: struct #align(16) {
	n: i32,
	flag: b32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	y: i32 = 0
	switch {
	case data.n > 0:
		y = 1
	case data.n < 0:
		y = -1
	case:
		y = 0
	}
	_ = y

	z: i32 = 0
	switch {
	case data.flag:
		z = 10
		fallthrough
	case data.n == 0:
		z = 20
	}
	_ = z

	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	out = vec4(0, 0, 0, 1) if data.flag else vec4(1, 0, 0, 1)
	return out
}
