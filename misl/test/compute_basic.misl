Particle :: struct #align(16) {
	pos: [2]f32,
	vel: [2]f32,
}

Data :: struct #align(16) {
	particles: [^]Particle,
	count: u32,
}

@(size = 64)
cs :: proc "compute"(
	data: ^Data | SV_Data,
	gid: [3]u32 | SV_Global_Thread,
) {
	i := gid.x
	if i >= data.count do return
	data.particles[i].pos += data.particles[i].vel
}
