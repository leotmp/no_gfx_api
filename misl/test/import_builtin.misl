import "core:builtin"

vec2 :: [2]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	uv:  [2]f32,
}

// Override builtin name; still call the intrinsic via qualification.
sin :: proc(x: f32) -> f32 {
	return builtin.sin(x) * 2
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	out.pos = vec4(0, 0, 0, 1)
	out.uv = vec2(0, 0)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	x: f32 = sin(0.5)
	_ = builtin.i32(x)
	out = data.color
	return out
}
