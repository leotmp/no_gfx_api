// =============================================================================
// data/shader/test_untyped.misl — Untyped literal / expression resolution spec
//
// Target for oge/misl checker typing rules. Do NOT expect this to compile
// end-to-end today. Single vertex entry exercises untyped → concrete type
// resolution in decl, binary, builtin, and assign contexts.
//
// Rules under test:
//   a := 1      → i32
//   a := 1.0    → f32
//   a: f32 = 1  → f32 (context hint on RHS)
// =============================================================================

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Untyped_VS_In :: struct #align(16) {
	pos: [4]f32,
	scale: f32,
}

Untyped_VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	col: [4]f32,
}

// Single vertex shader — all untyped cases live in this body.
test_untyped_vs :: proc "vertex"(
	data: Untyped_VS_In | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: Untyped_VS_Out) {
	// -------------------------------------------------------------------------
	// 1. Decl without explicit type — default untyped literals
	// -------------------------------------------------------------------------
	int_lit := 1          // expect: i32
	float_lit := 1.0      // expect: f32
	//bool_lit := true      // expect: b32 // TODO: bool literals error
	int_sum := 1 + 2      // expect: i32 (untyped int binary stays int, then defaults)
	float_sum := 1.0 + 2  // expect: f32 (int promotes with float operand)
	mixed_sum := 1 + 2.0  // expect: f32
//
	//// -------------------------------------------------------------------------
	//// 2. Decl with explicit type — RHS must resolve via context hint
	//// -------------------------------------------------------------------------
	hinted_f32: f32 = 1           // expect: f32
	hinted_f32_expr: f32 = 1 + 2  // expect: f32 (whole untyped int expr coerced)
	hinted_i32: i32 = 42          // expect: i32
	hinted_sum: f32 = 1 + 2.0
//
	//// -------------------------------------------------------------------------
	//// 3. Untyped literals in arithmetic with typed locals
	//// -------------------------------------------------------------------------
	typed_scale := data.scale
	scale_plus_one := typed_scale + cast(f32)1       // expect: f32 (untyped int → f32)
	one_plus_scale := f32(1) + typed_scale
	//scale_times_half := typed_scale * 0.5   // expect: f32 (untyped float literal)
	//offset := typed_scale - 1             // expect: f32
//
	//// -------------------------------------------------------------------------
	//// 4. Homogeneous builtins — untyped args must match gen of first arg
	//// -------------------------------------------------------------------------
	//scalar_lerp := lerp(0.0, 1.0, 0.5)                    // third arg untyped float
	//scalar_clamp := clamp(typed_scale, 0, 1)              // bounds untyped int
	//// scalar_step := step(0.5, typed_scale)                 // edge untyped float
	//scalar_smooth := smoothstep(0, 1, typed_scale)        // edges untyped int
	//scalar_min := min(typed_scale, 1)                     // second arg untyped int
	//scalar_max := max(1, typed_scale)                     // first arg untyped int
	//scalar_pow := pow(typed_scale, 2)                     // exponent untyped int
	//scalar_mod := mod(typed_scale, 2)                       // divisor untyped int
//
	//// vec_lerp := lerp(vec3(0, 0, 0), vec3(1, 1, 1), 0.5) // mix factor untyped float
	//vec_clamp := clamp(data.pos.xyz, 0, 1)                // bounds untyped int per component
//
	//// -------------------------------------------------------------------------
	//// 5. Vector / matrix constructors — untyped elems resolve to elem type
	//// -------------------------------------------------------------------------
	//from_vec3_ctor := vec3(1, 2, 3)           // expect: vec3 (elems → f32)
	//from_vec4_ctor := vec4(0, 0, 0, 1)        // expect: vec4
	//from_vec2_ctor := vec2(1, 2)              // expect: vec2
	//untyped_swizzle_base := vec4(1, 1, 1, 1)  // expect: vec4
//
	//// -------------------------------------------------------------------------
	//// 6. Assign with typed LHS — RHS untyped subexpr gets hint from target
	//// -------------------------------------------------------------------------
	//out.col = vec4(1, 1, 1, 1)                // untyped elems → f32 fields
	//out.col.r = 0                             // untyped int → f32 component
	//out.col.g = 0.5                           // untyped float literal
//
	//hinted_assign: f32 = typed_scale + 1      // expect: f32
//
	//// -------------------------------------------------------------------------
	//// 7. Comparisons — untyped operands; result used as f32 weight
	//// -------------------------------------------------------------------------
	//is_positive := typed_scale > 0            // expect: bool (or b32)
	//// weight := is_positive ? 1.0 : 0.0         // untyped float literals in ternary branches
//
	//// -------------------------------------------------------------------------
	//// 8. Folded expression feeding SV_Position (codegen smoke path)
	//// -------------------------------------------------------------------------
	//t := clamp(scalar_lerp + float_sum * 0.1, 0, 1)
	//p := data.pos
	//// p.xyz = p.xyz * scale_plus_half + vec_lerp * t
	//p.w = 1
//
	//out.pos = p
	//out.col.a = hinted_f32
	//// out.col.rgb = from_vec3_ctor * weight + untyped_swizzle_base.rgb * (1 - weight)
//
	//// Touch remaining locals so they survive dead-code elimination in codegen tests.
	//// out.col.r += f32(int_lit + int_sum)
	//out.col.g += float_lit + mixed_sum
	//out.col.b += scale_times_half + offset
	//out.col.a += scalar_step + scalar_smooth + scalar_min + scalar_max
	//out.col.rgb += vec3(scalar_pow, scalar_mod, scalar_clamp)
	//out.col.rgb += from_vec4_ctor.rgb + from_vec2_ctor.x
	//out.col.a += hinted_f32_expr + f32(hinted_i32) + hinted_assign
	//if bool_lit {
	//	out.pos.x += f32(vertex_id)
	//}

	// -------------------------------------------------------------------------
	// 9. Matrix element types — numeric scalars only (int or float, not bool)
	// -------------------------------------------------------------------------
	// mat_f32: matrix[4,4]f32   // valid
	// mat_i32: matrix[4,4]i32   // valid
	// mat_bool: matrix[4,4]bool // reject at check_matrix_type
	//
	// mat_mul_vec: matrix[4,4]f32 * [4]f32 → [4]f32
	// vec_mul_mat: [4]f32 * matrix[4,4]f32 → [4]f32
	// mat_scalar: matrix[4,4]f32 * 2 → matrix[4,4]f32 (untyped int → elem)
	// mat_assign: m: matrix[4,4]f32 = 1 + 0  // untyped expr → matrix constructor
	//
	// -------------------------------------------------------------------------
	// 10. Enum backing — integer scalar only
	// -------------------------------------------------------------------------
	// enum u32 { A, B }   // valid
	// enum f32 { A, B }   // reject at check_enum_type

	return out
}
