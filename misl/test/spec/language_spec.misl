// [implemented] if / else if / else
test_if :: proc(flags: Flags, x: f32) -> (out: f32) {
	if flags == .Visible {
		out = x
	} else if flags == .Shadow {
		out = x * 0.5
	} else {
		out = 0
	}
	return out
}

// [partial] if-with-init (checker ok; CG skips init)
test_if_init :: proc(x: f32) -> (out: f32) {
	if y := x * 2; y > 1.0 {
		out = y
	} else {
		out = 0
	}
	return out
}

// [implemented] C-style for
test_for_c :: proc(n: i32) -> (sum: i32) {
	sum = 0
	for i := 0; i < n; i += 1 {
		sum += i
	}
	return sum
}

