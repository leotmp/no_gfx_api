// =============================================================================
// 7. SHADER ENTRIES — oge/gpu interface
// =============================================================================

// [implemented] Vertex stage — SV_Data, SV_Vertex, SV_Instance, SV_Position
test_vs :: proc "vertex"(
	data: Scene_Data | SV_Data,
	instance_id: u32 | SV_Instance,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	inst := data.instances[instance_id]
	vert := data.vertices[vertex_id]

	local := [4]vec2 {
		vec2(-1, -1),
		vec2( 1, -1),
		vec2(-1,  1),
		vec2( 1,  1),
	}[vertex_id]

	p := transform_point(data.camera, vert.pos.xy + local)
	out.pos = data.camera * vec4(p, 0, 1)
	out.col = vert.col
	out.uv = vert.uv
	out.instance_id = instance_id
	return out
}

// [implemented] Fragment stage — inter-stage struct + SV_Data + SV_Target
test_fs :: proc "fragment"(
	fsin: VS_Out,
	uniforms: FS_Uniforms | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	screen_uv := fsin.pos.xy / vec2(1) // placeholder; real code uses resolution from SV_Data

	out = sample(uniforms.atlas, uniforms.atlas_sampler, fsin.uv)
	out.rgb *= uniforms.tint

	// single-return call assign to local (tuple bug regression)
	tmp := linear_from_srgb(out.rgb)
	out.rgb = tmp

	// multi-return unpack
	r, g := returns_two()
	out.rg += vec2(r, g) * 0.01

	if fsin.instance_id > 0 {
		out.rgb = hsv_from_rgb(out.rgb)
	}

	return out
}

// [implemented] Fragment-only entry (no VS input struct)
test_light_fs :: proc "fragment"(data: Scene_Data | SV_Data) -> (out: [4]f32 | SV_Target) {
	out = vec4(0.1, 0.1, 0.15, 1)
	return out
}

