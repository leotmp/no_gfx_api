// Import compiler-embedded core:s2h.misl. Fragment uses gather print_txt
// specializations, print_int, and vector unary / compound assign.

import "core:s2h.misl"

vec2 :: [2]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	uv:  [2]f32,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	out.uv = vec2(0, 0)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	ui := s2h.init(fsin.pos.xy)
	s2h.print_txt(&ui, "ok")
	s2h.print_txt(&ui, "hi")
	s2h.print_int(&ui, 42)
	hs := vec2(3, 4)
	hs /= 5
	_ = -hs
	_ = data
	out = ui.dst_color
	return out
}
