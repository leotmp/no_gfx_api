// glslang treats unsuffixed 4294967295 as a signed int that overflows to -1.
// Dividing by that constant must emit a uint or float literal, not float(4294967295).
ivec2 :: [2]i32
vec4  :: [4]f32

Data :: struct #align(16) {
	dst: rw32_2d,
}

@(size = {8, 8})
cs :: proc "compute"(
	data: ^Data | SV_Data,
	gid: [3]u32 | SV_Global_Thread,
) {
	res := dim(data.dst)
	if gid.x >= u32(res.x) || gid.y >= u32(res.y) do return
	r := f32(gid.x) / 4294967295
	store(data.dst, ivec2(i32(gid.x), i32(gid.y)), vec4(r, 0, 0, 1))
}
