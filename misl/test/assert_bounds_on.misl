#+feature no_bounds_check

vec4 :: [4]f32

Item :: struct #align(16) {
	v: f32,
}

Data :: struct #align(16) {
	items: []Item,
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	i: i32 = 0
	x := #bounds_check data.items[i]
	_ = x.v
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin.pos
	out = data.color
	return out
}
