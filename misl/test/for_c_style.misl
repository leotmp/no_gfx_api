// C-style for with optional empty post: `for init; cond; {}` and `for init; cond {}`
vec4 :: [4]f32

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	vid: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = vid
	sum: i32 = 0
	for i := 0; i < 4; i += 1 {
		sum += i
	}
	for j := 0; j < 3; {
		sum += j
		j += 1
	}
	for k := 0; k < 2 {
		sum += k
		k += 1
	}
	_ = sum
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	out = vec4(1, 0, 0, 1)
	return out
}
