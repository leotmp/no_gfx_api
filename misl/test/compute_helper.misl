Particle :: struct #align(16) {
	pos: [2]f32,
}

Data :: struct #align(16) {
	particles: [^]Particle,
	count: u32,
}

in_range :: proc(i: u32, count: u32) -> b32 {
	return i < count
}

bump_at :: proc(p: [^]Particle, i: u32) {
	p[i].pos.x += 1
}

bump :: proc(data: ^Data, i: u32) {
	bump_at(data.particles, i)
}

@(size = 64)
cs :: proc "compute"(
	data: ^Data | SV_Data,
	gid: [3]u32 | SV_Global_Thread,
) {
	if in_range(gid.x, data.count) {
		bump(data, gid.x)
	}
}
