vec2 :: [2]f32
vec4 :: [4]f32

Item :: struct #align(16) {
	v: f32,
}

Data :: struct #align(16) {
	color: [4]f32,
	items: []Item,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	#flat id: u32,
	uv: [2]f32,
}

// multi-return helper
split :: proc(x: f32) -> (a: f32, b: f32) {
	return x, x + 1
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	// zero-init + explicit non-init
	z: i32
	u: i32 = ---
	_ = z
	_ = u

	// type-call cast + const fold
	n := i32(3)
	_ = n

	// multi-return assign
	a, b := split(1.0)
	_ = a
	_ = b

	// slice index + len
	count := len(data.items)
	_ = count
	if count > 0 {
		_ = data.items[0].v
	}

	// swizzle write
	c := vec4(1, 2, 3, 4)
	c.xy = vec2(0, 0)
	_ = c

	// bitwise compound
	flags: u32 = 0
	flags &~= 1
	_ = flags

	out.pos = vec4(0, 0, 0, 1)
	out.id = vertex_id
	out.uv = vec2(0, 0)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin.id
	out = data.color
	return out
}
