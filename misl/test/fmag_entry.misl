vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

scale :: proc(x: f32) -> f32 {
	return x
}

shade :: proc "fmag"(
	ndv: f32, ndl: f32, ldh: f32, vdh: f32,
	albedo: [3]f32,
	metallic: f32, roughness: f32,
	D: f32, G: f32,
	light: f32,
) -> [3]f32 {
	return albedo * abs(scale(light))
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	out = data.color
	return out
}
