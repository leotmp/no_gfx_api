vec2 :: [2]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
	uv:  [2]f32,
}

HALF :: 2.5 + 3 // Exact_Value fold → typed literal on site

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	SCALE :: 2
	ok := !(1 == 0)
	_ = ok
	_ = SCALE

	out.pos = vec4(HALF, HALF, 0, 1)
	out.uv = vec2(0, 0)

	// flexible stage return: any expr (not only the named result ident)
	r := out
	return {
		pos = out.pos,
		uv = out.uv,
	}
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	out = data.color
	return // naked return unpacks named result
}
