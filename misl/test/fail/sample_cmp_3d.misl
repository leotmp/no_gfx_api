// Expect: comparison sampling is not available
vec4 :: [4]f32
vec3 :: [3]f32

Data :: struct #align(16) {
	tex: t32_3d,
	samp: s32_cmp,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	_ = sample(data.tex, data.samp, vec3(0, 0, 0), 0.5)
	out = vec4(0, 0, 0, 1)
	return out
}
