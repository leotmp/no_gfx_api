vec2 :: [2]f32
vec4 :: [4]f32
mat2 :: matrix[2, 2]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	col0 := vec2(1, 0)
	col1 := vec2(0, 1)
	// Illegal: Comp_Lit does not splice column vectors (constructors may)
	m := mat2{col0, col1}
	_ = m
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin.pos
	out = data.color
	return out
}
