// Expect: proc width_of called in vertex shader 'vs', contains a call to 'fwidth'
vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

width_of :: proc(x: f32) -> f32 {
	return fwidth(x)
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	_ = width_of(1.0)
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	out = data.color
	return out
}
