// Expect: fragment input 'n' (NORMAL) is not written by the vertex
NORMAL :: #inout([3]f32, 0)
Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vid: u32 | SV_Vertex) -> (out: Out) {
	out.pos = [4]f32{0, 0, 0, 1}
	return out
}

fs :: proc "fragment"(n: [3]f32 | NORMAL) -> (out: [4]f32 | SV_Target) {
	return [4]f32{n.x, 0, 0, 1}
}
p :: pipeline { vertex = vs, fragment = fs, targets = {{format = .rgba_u8_norm}} }
