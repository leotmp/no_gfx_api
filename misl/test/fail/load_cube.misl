// Expect: cannot fetch cube
vec4 :: [4]f32

Data :: struct #align(16) {
	tex: t32_cube,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	_ = load(data.tex, [3]i32{0, 0, 0})
	out = vec4(0, 0, 0, 1)
	return out
}
