// Expect: 'fog' interpolation differs
FOG :: #inout(f32, 0)
vs :: proc "vertex"(vid: u32 | SV_Vertex) -> (pos: [4]f32 | SV_Position, #noperspective fog: f32 | FOG) {
	return [4]f32{0, 0, 0, 1}, 1
}
fs :: proc "fragment"(fog: f32 | FOG) -> (out: [4]f32 | SV_Target) {
	return [4]f32{fog, 0, 0, 1}
}
p :: pipeline { vertex = vs, fragment = fs, targets = {{format = .rgba_u8_norm}} }
