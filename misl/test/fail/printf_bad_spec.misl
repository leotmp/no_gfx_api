import "core:debug"

vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	x: f32 = 1
	debug.printf("x=%f\n", x)
	out.pos = vec4(0, 0, 0, 1)
	return out
}
