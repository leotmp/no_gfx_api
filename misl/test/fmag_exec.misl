import "core:fmag"

vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	code: [][4]u32,
	light: f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

// Imports core:fmag but never calls exec — must not grow a register file.
scale :: proc(x: f32) -> f32 {
	return x * f32(fmag.REGS)
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = data
	_ = vertex_id
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	col: [3]f32
	col = fmag.exec(data.code, 1, 2, vec3(0.1, 0.2, 0.3), data.light)
	x: f32
	x = fmag.exec(data.code, 0.5)
	out.rgb = col * scale(x)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
