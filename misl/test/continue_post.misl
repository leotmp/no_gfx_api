vec4 :: [4]f32

Data :: struct #align(16) {
	color: [4]f32,
	limit: i32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(
	data: ^Data | SV_Data,
	vertex_id: u32 | SV_Vertex,
) -> (out: VS_Out) {
	_ = vertex_id
	acc: i32 = 0
	for i: i32 = 0; i < data.limit; i += 1 {
		if i == 2 {
			continue
		}
		acc += i
	}
	for j in 0 ..< data.limit {
		if j == 1 {
			continue
		}
		acc += j
	}
	_ = acc
	out.pos = vec4(0, 0, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	_ = fsin
	out = data.color
	return out
}
