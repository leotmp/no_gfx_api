import "core:atmosphere.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	sun:        f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, sun: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "atmosphere")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 3)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "sun  ")
	az := sun
	s2h.slider_float(&ui, 12, &az, 0, 6.2831853)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	sun := normalize(vec3(sin(data.sun), 0.35, cos(data.sun)))
	view := normalize(vec3(uv.x, uv.y + 0.2, 1.2))
	col: vec3
	if data.mode == 0 {
		col = atmosphere.sky_rayleigh_mie(view, sun)
	} else if data.mode == 1 {
		ground := vec3(0.15, 0.18, 0.12)
		col = atmosphere.aerial_perspective(ground, mag(uv) * 40, view, sun)
	} else if data.mode == 2 {
		col = atmosphere.blackbody(2000 + uv.x * 8000)
	} else {
		col = atmosphere.rgb_from_wavelength(380 + uv.x * 400)
	}
	_ = atmosphere.phase_rayleigh(dot(view, sun))
	_ = atmosphere.phase_hg(dot(view, sun), 0.7)
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.sun)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
