import "core:filter.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	tex:        t32_2d,
	samp:       s32,
	param:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

apply :: proc(uv: vec2, data: ^Data) -> vec3 {
	tex := data.tex
	s := data.samp
	res := vec2(128, 128)
	p := data.param
	m := data.mode
	if m == 0 {
		return sample(tex, s, uv).xyz
	}
	if m == 1 {
		return filter.box_blur(tex, s, uv, res, 2)
	}
	if m == 2 {
		return filter.gaussian_blur(tex, s, uv, res, vec2(1, 0), 1 + p * 2)
	}
	if m == 3 {
		return filter.bilateral(tex, s, uv, res, 1.2, 0.08 + p * 0.2)
	}
	if m == 4 {
		return filter.mean3x3(tex, s, uv, res)
	}
	if m == 5 {
		return filter.median3x3(tex, s, uv, res)
	}
	if m == 6 {
		return filter.laplacian(tex, s, uv, res) * 0.5 + 0.5
	}
	if m == 7 {
		return filter.sobel(tex, s, uv, res)
	}
	if m == 8 {
		return filter.prewitt(tex, s, uv, res)
	}
	if m == 9 {
		return filter.kuwahara(tex, s, uv, res)
	}
	if m == 10 {
		return filter.radial_blur(tex, s, uv, vec2(0.5, 0.5), 0.05 + p * 0.1)
	}
	if m == 11 {
		return filter.noise_blur(tex, s, uv, res, 1 + p * 4, uv * 20)
	}
	if m == 12 {
		return filter.fibonacci_bokeh(tex, s, uv, res, 2 + p * 6)
	}
	if m == 13 {
		return filter.cas(tex, s, uv, res, p)
	}
	return filter.sharpen(tex, s, uv, res, p * 2)
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, param: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "filter")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 13)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "amt  ")
	p := param
	s2h.slider_float(&ui, 12, &p, 0, 1)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	c := apply(uv, data)
	_ = filter.smart_denoise(data.tex, data.samp, uv, vec2(128, 128))
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.param)
	out.rgb = lerp(c, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
