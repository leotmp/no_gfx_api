import "core:ao.misl"
import "core:sdf.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 72), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "ao")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 1)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

map_p :: proc(p: vec3) -> f32 {
	d := sdf.sd_sphere(p, 0.55)
	box := sdf.sd_box3(p - vec3(0, -0.4, 0), vec3(1.2, 0.15, 1.2))
	return sdf.op_union(d, box)
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	// SV_Position is window pixels (Y down); NDC Y must flip so world +Y is screen up.
	uv.y = -uv.y
	ro := vec3(0, 0.4, 2.4)
	rd := normalize(vec3(uv, -1.7))
	tt := 0.0
	hit := 0.0
	for i := 0; i < 56; i += 1 {
		p := ro + rd * tt
		d := map_p(p)
		if d < 0.002 {
			hit = 1
			break
		}
		tt += d
		if tt > 10 {
			break
		}
	}
	col := vec3(0.03, 0.03, 0.04)
	if hit > 0.5 {
		p := ro + rd * tt
		e := 0.01
		n := normalize(vec3(
			map_p(p + vec3(e, 0, 0)) - map_p(p - vec3(e, 0, 0)),
			map_p(p + vec3(0, e, 0)) - map_p(p - vec3(0, e, 0)),
			map_p(p + vec3(0, 0, e)) - map_p(p - vec3(0, 0, e)),
		))
		occ := 0.0
		for k := 1; k <= 5; k += 1 {
			occ += max(map_p(p + n * f32(k) * 0.06), 0)
		}
		vis := clamp(occ / 5, 0, 1)
		alb := vec3(0.6, 0.45, 0.3)
		mb := ao.gtao_multibounce(vis, alb)
		sao := ao.specular_ao(vis, 0.4, max(dot(n, -rd), 0))
		hao := ao.horizon_specular_ao(vis, 0.4)
		if data.mode == 0 {
			col = alb * mb
		} else {
			col = vec3(sao, hao, vis)
		}
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
