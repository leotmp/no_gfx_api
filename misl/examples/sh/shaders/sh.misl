import "core:sh.misl"
import "core:sdf.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	blend:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

overlay :: proc(px: vec2, mouse: vec4, blend: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 72), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "SH")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mix  ")
	m := blend
	s2h.slider_float(&ui, 12, &m, 0, 1)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	ro := vec3(0, 0, 2.2)
	rd := normalize(vec3(uv, -1.6))
	tt := 0.0
	hit := 0.0
	for i := 0; i < 48; i += 1 {
		p := ro + rd * tt
		d := sdf.sd_sphere(p, 0.85)
		if d < 0.002 {
			hit = 1
			break
		}
		tt += d
		if tt > 8 {
			break
		}
	}
	col := vec3(0.03, 0.03, 0.04)
	if hit > 0.5 {
		n := normalize(ro + rd * tt)
		l0 := vec3(0.22, 0.2, 0.28)
		l1 := vec3(0.15, 0.25, 0.1)
		a := sh.irradiance_l1(n, l0, l1)
		b := sh.evaluate_l2(n, l0, l1, vec3(0.05, 0, 0), vec3(0, 0.04, 0), vec3(0, 0, 0.06), vec3(0.02, 0.01, 0))
		col = lerp(a, b, data.blend)
		_ = sh.sh_y00()
		_ = sh.sh_y1(n)
		_ = sh.sh_y2(n)
		_ = sh.sh_y2_xy(n)
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.blend)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
