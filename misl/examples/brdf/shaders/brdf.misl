import "core:brdf.misl"
import "core:s2h.misl"
import "core:sdf.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	rough:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, rough: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "brdf")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 7)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "r    ")
	r := rough
	s2h.slider_float(&ui, 12, &r, 0.04, 1)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	ro := vec3(0, 0, 2.2)
	rd := normalize(vec3(uv, -1.6))
	t := sdf.sd_sphere(ro, 0.85)
	_ = t
	hit := 0.0
	tt := 0.0
	for i := 0; i < 48; i += 1 {
		p := ro + rd * tt
		d := sdf.sd_sphere(p, 0.85)
		if d < 0.002 {
			hit = 1
			break
		}
		tt += d
		if tt > 8 {
			break
		}
	}
	col := vec3(0.03, 0.03, 0.04)
	if hit > 0.5 {
		p := ro + rd * tt
		n := normalize(p)
		v := -rd
		l := normalize(vec3(0.4, 0.7, 0.5))
		h := normalize(v + l)
		ndh := max(dot(n, h), 0)
		ndv := max(dot(n, v), 0)
		ndl := max(dot(n, l), 0)
		ldh := max(dot(l, h), 0)
		r := data.rough
		f0 := vec3(0.04, 0.04, 0.04)
		term := 0.0
		if data.mode == 0 {
			term = brdf.ndf_ggx(ndh, r)
		} else if data.mode == 1 {
			term = brdf.ndf_beckmann(ndh, r)
		} else if data.mode == 2 {
			term = brdf.ndf_charlie(ndh, r)
		} else if data.mode == 3 {
			term = brdf.smith_ggx_correlated(ndv, ndl, r)
		} else if data.mode == 4 {
			f := brdf.fresnel_schlick(ldh, f0)
			term = f.x
		} else if data.mode == 5 {
			term = brdf.burley(ndv, ndl, ldh, r) * ndl
		} else if data.mode == 6 {
			term = brdf.oren_nayar(ndv, ndl, r)
		} else {
			s := brdf.specular_ggx(n, v, l, r, f0)
			term = s.x
		}
		col = vec3(term, term, term)
		_ = brdf.lambert()
		_ = brdf.env_brdf_approx(ndv, r)
		_ = brdf.f0_from_ior(1.5)
		_ = brdf.smith_g1_ggx(ndv, r)
		_ = brdf.fresnel_schlick_roughness(ndv, f0, r)
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.rough)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
