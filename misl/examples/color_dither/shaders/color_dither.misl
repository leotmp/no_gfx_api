import "core:color.misl"
import "core:s2h.misl"
import "core:math.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	levels:     f32,
	noise:      t32_2d,
	samp:       s32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

quant :: proc(c: vec3, levels: f32, n: f32) -> vec3 {
	q := c * levels + n
	return floor(q) / levels
}

apply :: proc(c: vec3, px: vec2, uv: vec2, data: ^Data) -> vec3 {
	m := data.mode
	n := 0.0
	if m == 0 {
		n = color.dither_bayer4(px) - 0.5
	} else if m == 1 {
		n = color.dither_bayer8(px) - 0.5
	} else if m == 2 {
		n = color.dither_ign(px) - 0.5
	} else if m == 3 {
		n = color.dither_triangle_pdf(color.dither_ign(px))
	} else if m == 4 {
		v := color.dither_vlachos(px)
		n = v.x
	} else {
		n = color.dither_blue_hash(px) - 0.5
		n = n * 0.5 + (color.dither_blue_tex(data.noise, data.samp, uv * 8) - 0.5) * 0.5
	}
	return quant(c, data.levels, n)
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, levels: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(440, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "dither")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 5)
	s2h.print_space(&ui, 1)
	if mode == 0 {
		s2h.print_txt(&ui, "bayer4")
	} else if mode == 1 {
		s2h.print_txt(&ui, "bayer8")
	} else if mode == 2 {
		s2h.print_txt(&ui, "ign")
	} else if mode == 3 {
		s2h.print_txt(&ui, "triangle pdf")
	} else if mode == 4 {
		s2h.print_txt(&ui, "vlachos")
	} else {
		s2h.print_txt(&ui, "blue hash+tex")
	}
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "n    ")
	n := levels
	s2h.slider_float(&ui, 12, &n, 2, 64)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	src := color.heatmap(uv.x) * (0.35 + 0.65 * uv.y)
	d := apply(src, fsin.pos.xy, uv, data)
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.levels)
	out.rgb = lerp(d, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
