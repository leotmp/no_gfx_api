import "core:pbr.misl"
import "core:sdf.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	light:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, light: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "pbr")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 3)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "lit  ")
	lit := light
	s2h.slider_float(&ui, 12, &lit, 1, 6)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	ro := vec3(0, 0, 2.2)
	rd := normalize(vec3(uv, -1.6))
	tt := 0.0
	hit := 0.0
	for i := 0; i < 48; i += 1 {
		p := ro + rd * tt
		d := sdf.sd_sphere(p, 0.85)
		if d < 0.002 {
			hit = 1
			break
		}
		tt += d
		if tt > 8 {
			break
		}
	}
	col := vec3(0.03, 0.03, 0.04)
	if hit > 0.5 {
		p := ro + rd * tt
		n := normalize(p)
		v := -rd
		l := normalize(vec3(0.45, 0.75, 0.4))
		st := n.xy * 0.5 + 0.5
		s := pbr.surface_make(vec3(0.72, 0.12, 0.08), st.x, clamp(st.y, 0.04, 1), 0.04)
		lit := vec3(3, 2.8, 2.5) * data.light
		if data.mode == 0 {
			col = pbr.evaluate_lit(s, n, v, l, lit)
		} else if data.mode == 1 {
			col = pbr.evaluate_clearcoat(s, 0.12, n, v, l, lit)
		} else if data.mode == 2 {
			col = pbr.evaluate_glass(s, n, v, l, lit)
		} else {
			col = pbr.ibl_approx(s, n, v, vec3(0.15, 0.18, 0.22), vec3(1.2, 1.1, 1) * data.light)
		}
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.light)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
