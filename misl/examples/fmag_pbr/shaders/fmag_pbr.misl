import "core:fmag.misl"
import "core:brdf.misl"
import "core:sdf.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	light:      f32,
	s2h_mouse:  [4]f32,
	code:       [][4]u32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}



overlay :: proc(px: vec2, mouse: vec4, light: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 80), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "fmag pbr")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "lit  ")
	lit := light
	s2h.slider_float(&ui, 12, &lit, 1, 6)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

// Flattened Burley + GGX mix. D and G are precomputed in the fragment
// because FMAG has no sqrt/div opcode that fits in 16 registers.
shade :: proc "fmag"(
	ndv: f32, ndl: f32, ldh: f32, vdh: f32,
	albedo: [3]f32,
	metallic: f32, roughness: f32,
	D: f32, G: f32,
	light: f32,
) -> [3]f32 {
	f0 := lerp(vec3(0.04, 0.04, 0.04), albedo, metallic)
	one_m := 1 - metallic
	f90 := 0.5 + 2 * ldh * ldh * roughness
	oml := 1 - ndl
	omv := 1 - ndv
	oml2 := oml * oml
	omv2 := omv * omv
	fl := 1 + (f90 - 1) * oml2 * oml2 * oml
	fv := 1 + (f90 - 1) * omv2 * omv2 * omv
	burley := 0.318309886 * fl * fv
	diff := albedo * one_m * burley
	omh := 1 - vdh
	omh2 := omh * omh
	F := f0 + (1 - f0) * omh2 * omh2 * omh
	spec := D * G * F * ndl
	return (diff + spec) * vec3(3, 2.8, 2.5) * light
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	ro := vec3(0, 0, 2.2)
	rd := normalize(vec3(uv, -1.6))
	tt := 0.0
	hit := 0.0
	for i := 0; i < 48; i += 1 {
		p := ro + rd * tt
		d := sdf.sd_sphere(p, 0.85)
		if d < 0.002 {
			hit = 1
			break
		}
		tt += d
		if tt > 8 {
			break
		}
	}
	col := vec3(0.03, 0.03, 0.04)
	if hit > 0.5 {
		p := ro + rd * tt
		n := normalize(p)
		v := -rd
		l := normalize(vec3(0.45, 0.75, 0.4))
		st := n.xy * 0.5 + 0.5
		albedo := vec3(0.72, 0.12, 0.08)
		metallic := st.x
		roughness := clamp(st.y, 0.04, 1)
		h := normalize(v + l)
		ndv := max(dot(n, v), 1e-4)
		ndl := max(dot(n, l), 0)
		ndh := max(dot(n, h), 0)
		ldh := max(dot(l, h), 0)
		vdh := max(dot(v, h), 0)
		D := brdf.ndf_ggx(ndh, roughness)
		G := brdf.smith_ggx_correlated(ndv, ndl, roughness)
		col = fmag.exec(data.code, ndv, ndl, ldh, vdh, albedo, metallic, roughness, D, G, data.light)
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.light)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
