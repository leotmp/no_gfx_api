import "core:draw.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	stroke_w:   f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

shape :: proc(p: vec2, mode: i32, t: f32) -> f32 {
	if mode == 0 {
		return draw.circle(p, 0.35)
	}
	if mode == 1 {
		return draw.rect(p, vec2(0.4, 0.22))
	}
	if mode == 2 {
		return draw.line(p, vec2(-0.4, -0.2), vec2(0.4, 0.25))
	}
	if mode == 3 {
		return draw.tri(p, 0.4)
	}
	if mode == 4 {
		return draw.hex(p, 0.35)
	}
	if mode == 5 {
		return draw.arrow(p, vec2(-0.45, 0), vec2(0.4, 0.15), 0.12)
	}
	if mode == 6 {
		return draw.axis2(p, 0.55)
	}
	n := i32(mod(floor(t * 2), 10))
	return draw.digit(p * 1.4, n)
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, stroke_w: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "draw")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 7)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "w    ")
	w := stroke_w
	s2h.slider_float(&ui, 12, &w, 0.004, 0.08)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	p := (uv * 2 - 1) * vec2(data.resolution.x / data.resolution.y, 1)
	d := shape(p, data.mode, data.time)
	f := draw.fill(d, 0.004)
	s := draw.stroke(d, data.stroke_w, 0.003)
	c := vec3(0.12, 0.14, 0.18) + vec3(0.2, 0.55, 0.85) * f * 0.35 + vec3(1, 0.92, 0.4) * s
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.stroke_w)
	out.rgb = lerp(c, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
