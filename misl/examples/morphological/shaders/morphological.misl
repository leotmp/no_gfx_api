import "core:morphological.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	tex0:       t32_2d,
	tex1:       t32_2d,
	samp:       s32,
	param:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

apply :: proc(uv: vec2, data: ^Data) -> vec3 {
	tex := data.tex0
	s := data.samp
	res := vec2(128, 128)
	p := data.param
	m := data.mode
	if m == 0 {
		return morphological.dilate(tex, s, uv, res)
	}
	if m == 1 {
		return morphological.erode(tex, s, uv, res)
	}
	if m == 2 {
		seed := morphological.jfa_step(tex, s, uv, res, 4 + p * 16)
		return vec3(seed.x, seed.y, 0)
	}
	if m == 3 {
		px := 1 / res
		a := sample(tex, s, uv).x
		b := sample(tex, s, uv + vec2(px.x, 0)).x
		c := sample(tex, s, uv + vec2(0, px.y)).x
		d := sample(tex, s, uv + vec2(px.x, px.y)).x
		code := morphological.marching_squares_case(a, b, c, d, 0.5)
		t := f32(code) / 15
		return vec3(t, 1 - t, 0.2)
	}
	if m == 4 {
		flow := morphological.lucas_kanade(data.tex0, data.tex1, s, uv, res)
		return vec3(flow.x * 8 + 0.5, flow.y * 8 + 0.5, 0.2)
	}
	if m == 5 {
		keep := morphological.hashed_alpha(p, uv * res, 1)
		base := sample(tex, s, uv).xyz
		return base if keep else vec3(0, 0, 0)
	}
	if m == 6 {
		return morphological.mip_pyramid(tex, s, uv, p * 4)
	}
	return morphological.mip_average(tex, s, uv, res, 1 + p * 8)
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, param: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "morph")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 7)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "amt  ")
	p := param
	s2h.slider_float(&ui, 12, &p, 0, 1)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	c := apply(uv, data)
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.param)
	out.rgb = lerp(c, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
