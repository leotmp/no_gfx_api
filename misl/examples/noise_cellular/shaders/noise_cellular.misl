import "core:noise.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	freq:       f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, freq: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(440, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "cellular")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 2)
	s2h.print_space(&ui, 1)
	if mode == 0 {
		s2h.print_txt(&ui, "voronoi F1/F2")
	} else if mode == 1 {
		s2h.print_txt(&ui, "worley")
	} else {
		s2h.print_txt(&ui, "voronoise")
	}
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "freq ")
	f := freq
	s2h.slider_float(&ui, 12, &f, 1, 32)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	p := uv * data.freq
	c: vec3
	if data.mode == 0 {
		v := noise.voronoi2(p)
		c = vec3(v.x, v.y - v.x, v.z)
	} else if data.mode == 1 {
		w := noise.worley2(p)
		c = vec3(w.x, w.y, w.y - w.x)
	} else {
		n := noise.voronoise2(p, 0.9, 0.7)
		c = vec3(n, n, n)
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.freq)
	out.rgb = lerp(c, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
