import "core:sdf.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

map_p :: proc(p: vec3, mode: i32) -> f32 {
	if mode == 0 {
		return sdf.sd_sphere(p, 0.7)
	}
	if mode == 1 {
		return sdf.sd_box3(p, vec3(0.5, 0.5, 0.5))
	}
	if mode == 2 {
		return sdf.sd_rounded_box3(p, vec3(0.45, 0.35, 0.45), 0.08)
	}
	if mode == 3 {
		return sdf.sd_torus(p, vec2(0.55, 0.18))
	}
	if mode == 4 {
		return sdf.sd_capsule3(p, vec3(0, -0.4, 0), vec3(0, 0.4, 0), 0.22)
	}
	if mode == 5 {
		return sdf.sd_cylinder(p, 0.5, 0.35)
	}
	if mode == 6 {
		return sdf.sd_octahedron(p, 0.7)
	}
	return sdf.mandelbulb(p * 0.85, 8, 6)
}

normal_at :: proc(p: vec3, mode: i32) -> vec3 {
	e := 0.002
	return normalize(vec3(
		map_p(p + vec3(e, 0, 0), mode) - map_p(p - vec3(e, 0, 0), mode),
		map_p(p + vec3(0, e, 0), mode) - map_p(p - vec3(0, e, 0), mode),
		map_p(p + vec3(0, 0, e), mode) - map_p(p - vec3(0, 0, e), mode),
	))
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 72), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "raymarch")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 7)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := (fsin.pos.xy / data.resolution) * 2 - 1
	uv.x *= data.resolution.x / data.resolution.y
	an := data.time * 0.4
	ro := vec3(sin(an) * 2.4, 0.7, cos(an) * 2.4)
	ta := vec3(0, 0, 0)
	ww := normalize(ta - ro)
	uu := normalize(cross(ww, vec3(0, 1, 0)))
	vv := cross(uu, ww)
	rd := normalize(uv.x * uu + uv.y * vv + 1.6 * ww)
	t := 0.0
	hit := 0.0
	for i := 0; i < 64; i += 1 {
		p := ro + rd * t
		d := map_p(p, data.mode)
		if d < 0.002 {
			hit = 1
			break
		}
		t += d
		if t > 12 {
			break
		}
	}
	col := vec3(0.02, 0.03, 0.05)
	if hit > 0.5 {
		p := ro + rd * t
		n := normal_at(p, data.mode)
		l := normalize(vec3(0.4, 0.8, 0.3))
		dif := max(dot(n, l), 0.05)
		col = vec3(0.75, 0.7, 0.65) * dif
	}
	_ = sdf.sd_box_frame(vec3(0, 0, 0), vec3(0.5, 0.5, 0.5), 0.05)
	_ = sdf.sd_cone(vec3(0, 0.2, 0), vec2(0.5, 0.8))
	_ = sdf.sd_capped_cone(vec3(0, 0, 0), 0.4, 0.3, 0.1)
	_ = sdf.sd_hex_prism(vec3(0, 0, 0), vec2(0.3, 0.4))
	_ = sdf.sd_ellipsoid(vec3(0, 0, 0), vec3(0.4, 0.3, 0.5))
	_ = sdf.map_scene3(vec3(0.1, 0, 0))
	_ = sdf.op_extrude(0.1, 0.2, 0.3)
	_ = sdf.op_revolve(vec3(0.2, 0, 0.1), 0.2)
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
