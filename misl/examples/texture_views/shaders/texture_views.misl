import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	tex:        t32_2d,
	tex3d:      t32_3d,
	cube:       t32_cube,
	depth:      t32_2d,
	samp:       s32,
	samp_cmp:   s32_cmp,
	param:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

apply :: proc(uv: vec2, data: ^Data) -> vec3 {
	m := data.mode
	if m == 0 {
		return sample(data.tex, data.samp, uv, 0).xyz
	}
	if m == 1 {
		return sample(data.tex, data.samp, uv, data.param * 4).xyz
	}
	if m == 2 {
		p := vec3(uv, fract(data.time * 0.15))
		return sample(data.tex3d, data.samp, p).xyz
	}
	if m == 3 {
		dir := normalize(vec3(uv * 2 - 1, 1))
		return sample(data.cube, data.samp, dir).xyz
	}
	if m == 4 {
		d := sample(data.depth, data.samp_cmp, uv, data.param)
		return vec3(d, d, d)
	}
	s := sample(data.tex, data.samp, uv)
	w := fwidth(s.x) * 8
	return vec3(w, w, w)
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, param: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(420, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "views")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 5)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "lod  ")
	p := param
	s2h.slider_float(&ui, 12, &p, 0, 1)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	c := apply(uv, data)
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.param)
	out.rgb = lerp(c, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
