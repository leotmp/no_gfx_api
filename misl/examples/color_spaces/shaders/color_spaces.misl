import "core:color.misl"
import "core:s2h.misl"
import "core:math.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	lut:        t32_2d,
	samp:       s32,
	param:      f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

src_color :: proc(uv: vec2) -> vec3 {
	return color.rgb_from_hsv(vec3(uv.x, 0.75, 0.85 + 0.15 * uv.y))
}

roundtrip :: proc(src: vec3, back: vec3, uv: vec2) -> vec3 {
	return src if uv.y < 0.5 else math.saturate3(back)
}

apply :: proc(uv: vec2, data: ^Data) -> vec3 {
	src := src_color(uv)
	p := data.param
	m := data.mode
	if m == 0 {
		a := vec3(1, 0.1, 0.05)
		b := vec3(0.05, 0.2, 1)
		return color.oklab_mix(a, b, uv.x) if uv.y < 0.5 else lerp(a, b, uv.x)
	}
	if m == 1 {
		lin := color.linear_from_srgb(src)
		return color.srgb_from_linear(lin)
	}
	if m == 2 {
		return math.saturate3(color.xyz_from_rgb(src))
	}
	if m == 3 {
		xyy := color.xyy_from_xyz(color.xyz_from_rgb(src))
		return roundtrip(src, color.rgb_from_xyz(color.xyz_from_xyy(xyy)), uv)
	}
	if m == 4 {
		lab := color.lab_from_rgb(src)
		return roundtrip(src, color.rgb_from_lab(lab), uv)
	}
	if m == 5 {
		lch := color.lch_from_lab(color.lab_from_rgb(src))
		return roundtrip(src, color.rgb_from_lab(color.lab_from_lch(lch)), uv)
	}
	if m == 6 {
		hsv := color.hsv_from_rgb(src)
		return hsv if uv.y < 0.5 else color.rgb_from_hsv(hsv)
	}
	if m == 7 {
		hsl := color.hsl_from_rgb(src)
		return roundtrip(src, color.rgb_from_hsl(hsl), uv)
	}
	if m == 8 {
		return roundtrip(src, color.rgb_from_ycbcr(color.ycbcr_from_rgb(src)), uv)
	}
	if m == 9 {
		return roundtrip(src, color.rgb_from_yuv(color.yuv_from_rgb(src)), uv)
	}
	if m == 10 {
		return roundtrip(src, color.rgb_from_yiq(color.yiq_from_rgb(src)), uv)
	}
	if m == 11 {
		return roundtrip(src, color.rgb_from_cmyk(color.cmyk_from_rgb(src)), uv)
	}
	if m == 12 {
		return roundtrip(src, color.rgb_from_lms(color.lms_from_rgb(src)), uv)
	}
	if m == 13 {
		return roundtrip(src, color.rgb_from_ryb(color.ryb_from_rgb(src)), uv)
	}
	if m == 14 {
		return color.palette_heatmap(uv.x)
	}
	if m == 15 {
		return color.palette_turbo(uv.x)
	}
	if m == 16 {
		return color.palette_viridis(uv.x)
	}
	if m == 17 {
		return color.hue_shift(src, p)
	}
	if m == 18 {
		return color.vibrance(src, p * 2 - 0.5)
	}
	if m == 19 {
		return math.saturate3(color.exposure(src, p * 4 - 2))
	}
	if m == 20 {
		return math.saturate3(color.brightness_contrast(src, p - 0.5, 0.5 + p))
	}
	if m == 21 {
		return color.levels(src, 0.05, 0.95, 0.4 + p, 0, 1)
	}
	if m == 22 {
		return color.desaturate(src, p)
	}
	if m == 23 {
		return color.white_balance(src, p - 0.5, (p - 0.5) * 0.5)
	}
	if m == 24 {
		return color.daltonize(src, i32(p * 2.99), 1)
	}
	if m == 25 {
		lutc := color.lut2d(data.lut, data.samp, src, 16)
		return src if uv.y < 0.5 else lutc
	}
	if m == 26 {
		l := color.luma(src)
		l601 := color.luma_rec601(src)
		return vec3(l, l, l) if uv.y < 0.5 else vec3(l601, l601, l601)
	}
	a := src
	b := color.rgb_from_hsv(vec3(fract(uv.x + 0.3), 0.6, 0.7))
	if m == 27 {
		sa := vec4(a.x, a.y, a.z, 0.65)
		db := vec4(b.x, b.y, b.z, 1)
		if uv.x < 0.1 {
			return color.pd_over(sa, db).xyz
		}
		if uv.x < 0.2 {
			return color.pd_in(sa, db).xyz
		}
		if uv.x < 0.3 {
			return color.pd_out(sa, db).xyz
		}
		if uv.x < 0.4 {
			return color.pd_atop(sa, db).xyz
		}
		if uv.x < 0.5 {
			return color.pd_dst_over(sa, db).xyz
		}
		if uv.x < 0.6 {
			return color.pd_dst_in(sa, db).xyz
		}
		if uv.x < 0.7 {
			return color.pd_dst_out(sa, db).xyz
		}
		if uv.x < 0.8 {
			return color.pd_dst_atop(sa, db).xyz
		}
		if uv.x < 0.9 {
			return color.pd_xor(sa, db).xyz
		}
		return color.pd_plus(sa, db).xyz
	}
	if m == 28 {
		return color.blend_multiply(a, b) if uv.x < 0.25 else (color.blend_screen(a, b) if uv.x < 0.5 else (color.blend_overlay(a, b) if uv.x < 0.75 else color.blend_hard_light(a, b)))
	}
	if m == 29 {
		return color.blend_soft_light(a, b) if uv.x < 0.25 else (color.blend_color_dodge(a, b) if uv.x < 0.5 else (color.blend_color_burn(a, b) if uv.x < 0.75 else color.blend_difference(a, b)))
	}
	if m == 30 {
		return color.blend_darken(a, b) if uv.x < 0.25 else (color.blend_lighten(a, b) if uv.x < 0.5 else (color.blend_exclusion(a, b) if uv.x < 0.75 else color.blend_hue(a, b)))
	}
	return color.blend_saturation(a, b) if uv.x < 0.33 else (color.blend_color(a, b) if uv.x < 0.66 else color.blend_luminosity(a, b))
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, param: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "spaces")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 31)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "p    ")
	p := param
	s2h.slider_float(&ui, 12, &p, 0, 1)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	c := apply(uv, data)
	srgb := color.srgb_from_linear(math.saturate3(c))
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.param)
	out.rgb = lerp(srgb, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
