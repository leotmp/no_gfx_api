import "core:ssr.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	depth:      t32_2d,
	samp:       s32,
	stride:     f32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32, stride: f32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 104), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "ssr")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 1)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "str  ")
	st := stride
	s2h.slider_float(&ui, 12, &st, 0.004, 0.05)
	return ui.dst_color
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	dir := vec2(0.015, -0.02)
	col: vec3
	if data.mode == 0 {
		col = ssr.ssr_trace(data.depth, data.samp, uv, dir, 24, data.stride)
		base := sample(data.depth, data.samp, uv).xyz
		col = lerp(base, col, 0.65)
	} else {
		r := ssr.reflect_dir(normalize(vec3(uv * 2 - 1, 1)), vec3(0, 1, 0))
		col = ssr.ssr_cubemap(data.depth, data.samp, r)
	}
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode, data.stride)
	out.rgb = lerp(col, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
