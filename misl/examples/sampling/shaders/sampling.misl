import "core:sampling.misl"
import "core:s2h.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Data :: struct #align(16) {
	resolution: [2]f32,
	time:       f32,
	mode:       i32,
	s2h_mouse:  [4]f32,
	tex:        t32_2d,
	samp:       s32,
	nearest:    s32,
}

VS_Out :: struct {
	pos: [4]f32 | SV_Position,
}

vs :: proc "vertex"(vertex_id: u32 | SV_Vertex) -> (out: VS_Out) {
	positions := [3]vec2 {
		vec2(-1, -1),
		vec2(3, -1),
		vec2(-1, 3),
	}
	p := positions[vertex_id]
	out.pos = vec4(p, 0, 1)
	return out
}

apply :: proc(uv: vec2, data: ^Data) -> vec3 {
	res := vec2(64, 64)
	m := data.mode
	if m == 0 {
		s := sample(data.tex, data.nearest, uv * 3)
		return s.xyz
	}
	if m == 1 {
		s := sampling.bicubic(data.tex, data.samp, uv * 3, res)
		return s.xyz
	}
	if m == 2 {
		return sampling.fxaa(data.tex, data.samp, uv, data.resolution)
	}
	if m == 3 {
		d := uv.x
		v := sampling.pcf3(data.tex, data.samp, uv, res, d)
		return vec3(v, v, v)
	}
	if m == 4 {
		p := vec3(uv * 4, data.time * 0.1)
		n := normalize(vec3(0.2, 1, 0.3))
		return sampling.triplanar(data.tex, data.samp, p, n, 1)
	}
	if m == 5 {
		dir := normalize(vec3(uv * 2 - 1, 1))
		s := sampling.equirect(data.tex, data.samp, dir)
		return s.xyz
	}
	if m == 6 {
		return sampling.dof(data.tex, data.samp, uv, res, 4)
	}
	if m == 7 {
		s := sampling.flow(data.tex, data.samp, uv, vec2(sin(data.time) * 0.05, 0))
		return s.xyz
	}
	if m == 8 {
		n := sampling.normal_from_height(data.tex, data.samp, uv, res, 4)
		return n * 0.5 + 0.5
	}
	if m == 9 {
		q := sampling.quilt_uv(uv, 3, vec2(4, 3))
		return sample(data.tex, data.samp, q).xyz
	}
	if m == 10 {
		s := sampling.sprite(data.tex, data.samp, fract(uv * 2), vec2(1, 0), vec2(4, 4))
		return s.xyz
	}
	return sampling.sample_yuv(data.tex, data.samp, uv)
}

overlay :: proc(px: vec2, mouse: vec4, mode: i32) -> vec4 {
	ui := s2h.init(px)
	ui.mouse_input = mouse
	s2h.set_scale(&ui, 2)
	s2h.draw_rectangle(&ui, vec2(8, 8), vec2(400, 72), vec4(0, 0, 0, 0.65))
	s2h.set_cursor(&ui, vec2(16, 16))
	s2h.print_txt(&ui, "sampling")
	s2h.print_lf(&ui)
	s2h.print_txt(&ui, "mode ")
	mf := f32(mode)
	s2h.slider_float(&ui, 12, &mf, 0, 10)
	s2h.print_space(&ui, 1)
	s2h.print_int(&ui, mode)
	return ui.dst_color
}

fs :: proc "fragment"(
	fsin: VS_Out,
	data: ^Data | SV_Data,
) -> (out: [4]f32 | SV_Target) {
	uv := fsin.pos.xy / data.resolution
	c := apply(uv, data)
	_ = sampling.sample_clamp(data.tex, data.samp, uv * 1.2)
	hud := overlay(fsin.pos.xy, data.s2h_mouse, data.mode)
	out.rgb = lerp(c, hud.rgb, hud.a)
	out.a = 1
	return out
}

main_pipeline :: pipeline {
	topology = .Triangle_List,
	vertex = vs,
	fragment = fs,
	targets = {
		{
			format = .rgba_u8_srgb,
			write_mask = .All,
		},
	},
}
