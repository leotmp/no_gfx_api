/*
	Language gaps this translation hits (why the MISL API is not a 1:1 clone):

	- No procedure overloading. Gather vs scatter vs 3d keep distinct names
	  (print_txt / scatter_print_txt / init_3d). Compile-time `print_txt($str: string)`
	  replaces the old numbered 1–6 character overloads.
	- No user proc values / inlinable proc parameters. onGfxForAllScatter,
	  s2h_tableLookup*, s2h_floatLookupFloat, and scene/sceneWithShadows cannot
	  be "implement this in your TU". Scatter writes through Context_Scatter.dst
	  (rw32_2d). Tables/plots take []T. sceneWithShadows is not a library proc.
	- No while. Digit loops use C-style for.
	- No saturate. clamp(x, 0, 1).
	- Module-level MINI_FONT :: [192]u32{…} emits as a named GLSL `const uint[]`.
	- HLSL if (float) truthiness is illegal; comparisons are explicit.
	- No preprocessor. Version and GLSL/HLSL forks are just MISL.
	- Scatter lives in this same module and calls store(rw32_2d). Importing gather
	  into a fragment shader still sees those helpers in the TU. `when` / a
	  split file would keep imageStore out of graphics entries.
*/

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32
ivec2 :: [2]i32
mat4 :: matrix[4, 4]f32

S2H_VERSION :: 13
FLT_MAX :: 3.40282347e+38
FONT_SIZE :: 8.0

// s2h.hlsl: g_miniFont
MINI_FONT :: [192]u32{
	0x00306c6c, 0x30003860, 0x18600000, 0x00000006,
	0x00786c6c, 0x7cc66c60, 0x30306630, 0x0000000c,
	0x00786cfe, 0xc0cc38c0, 0x60183c30, 0x00000018,
	0x0030006c, 0x78187600, 0x6018fffc, 0x00fc0030,
	0x003000fe, 0x0c30dc00, 0x60183c30, 0x00000060,
	0x0000006c, 0xf866cc00, 0x30306630, 0x300030c0,
	0x0030006c, 0x30c67600, 0x18600000, 0x30003080,
	0x00000000, 0x00000000, 0x00000000, 0x60000000,
	0x7c307878, 0x1cfc38fc, 0x78780000, 0x18006078,
	0xc670cccc, 0x3cc060cc, 0xcccc3030, 0x300030cc,
	0xce300c0c, 0x6cf8c00c, 0xcccc3030, 0x60fc180c,
	0xde303838, 0xcc0cf818, 0x787c0000, 0xc0000c18,
	0xf630600c, 0xfe0ccc30, 0xcc0c0000, 0x60001830,
	0xe630cccc, 0x0ccccc30, 0xcc183030, 0x30fc3000,
	0x7cfcfc78, 0x1e787830, 0x78703030, 0x18006030,
	0x00000000, 0x00000000, 0x00000060, 0x00000000,
	0x7c30fc3c, 0xf8fefe3c, 0xcc781ee6, 0xf0c6c638,
	0xc6786666, 0x6c626266, 0xcc300c66, 0x60eee66c,
	0xdecc66c0, 0x666868c0, 0xcc300c6c, 0x60fef6c6,
	0xdecc7cc0, 0x667878c0, 0xfc300c78, 0x60fedec6,
	0xdefc66c0, 0x666868ce, 0xcc30cc6c, 0x62d6cec6,
	0xc0cc6666, 0x6c626066, 0xcc30cc66, 0x66c6c66c,
	0x78ccfc3c, 0xf8fef03e, 0xcc7878e6, 0xfec6c638,
	0x00000000, 0x00000000, 0x00000000, 0x00000000,
	0xfc78fc78, 0xfcccccc6, 0xc6ccfe78, 0xc0781000,
