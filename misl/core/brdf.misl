/*
	BRDF terms.

	GGX NDF: Walter et al. 2007. Smith GGX correlated: Heitz / Filament.
	Schlick Fresnel: Schlick 1994. Lambert: textbooks. Burley diffuse:
	Disney / Burley. Oren–Nayar: Oren & Nayar 1994. Beckmann NDF:
	Beckmann–Spizzichino. Charlie sheen: Estevez & Kulla (Imageworks).
	envBRDFApprox: Lazarov (SIGGRAPH 2013) / Karis. F0 from IOR: dielectrics.
	Filament (Apache 2) and Khronos glTF Sample Viewer as reference forms.
*/

import "core:math.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

f0_from_ior :: proc(ior: f32) -> f32 {
	a := (ior - 1) / (ior + 1)
	return a * a
}

fresnel_schlick :: proc(cos_theta: f32, f0: vec3) -> vec3 {
	return f0 + (1 - f0) * math.pow5(1 - math.saturate(cos_theta))
}

fresnel_schlick_roughness :: proc(cos_theta: f32, f0: vec3, roughness: f32) -> vec3 {
	return f0 + (max(vec3(1, 1, 1) * (1 - roughness), f0) - f0) * math.pow5(1 - math.saturate(cos_theta))
}

ndf_ggx :: proc(n_dot_h: f32, roughness: f32) -> f32 {
	a := roughness * roughness
	a2 := a * a
	d := n_dot_h * n_dot_h * (a2 - 1) + 1
	return a2 / (math.PI * d * d)
}

ndf_beckmann :: proc(n_dot_h: f32, roughness: f32) -> f32 {
	a := max(roughness * roughness, 1e-4)
	nh2 := n_dot_h * n_dot_h
	return exp((nh2 - 1) / (a * nh2)) / (math.PI * a * nh2 * nh2)
}

ndf_charlie :: proc(n_dot_h: f32, roughness: f32) -> f32 {
	inv := 1 / max(roughness, 1e-4)
	sin2 := 1 - n_dot_h * n_dot_h
	return (inv * 0.5 + 1) * pow(sin2, inv * 0.5) / math.PI
}

smith_g1_ggx :: proc(n_dot_x: f32, roughness: f32) -> f32 {
	a := roughness * roughness
	n := n_dot_x * n_dot_x
	return 2 * n_dot_x / (n_dot_x + sqrt(a + (1 - a) * n))
}

smith_ggx_correlated :: proc(n_dot_v: f32, n_dot_l: f32, roughness: f32) -> f32 {
	a := roughness * roughness
	ggxv := n_dot_l * sqrt(n_dot_v * n_dot_v * (1 - a) + a)
	ggxl := n_dot_v * sqrt(n_dot_l * n_dot_l * (1 - a) + a)
	return 0.5 / max(ggxv + ggxl, 1e-6)
}

lambert :: proc() -> f32 {
	return 1 / math.PI
}

burley :: proc(n_dot_v: f32, n_dot_l: f32, l_dot_h: f32, roughness: f32) -> f32 {
	f90 := 0.5 + 2 * l_dot_h * l_dot_h * roughness
	fl := 1 + (f90 - 1) * math.pow5(1 - n_dot_l)
	fv := 1 + (f90 - 1) * math.pow5(1 - n_dot_v)
	return lambert() * fl * fv
}

oren_nayar :: proc(n_dot_v: f32, n_dot_l: f32, roughness: f32) -> f32 {
	s := roughness * roughness
	a := 1 - 0.5 * s / (s + 0.33)
	b := 0.45 * s / (s + 0.09)
	ga := max(n_dot_l, n_dot_v)
	return lambert() * (a + b * max(0, n_dot_l) * (1 - n_dot_v) * (1 - n_dot_l) / max(ga, 1e-4)) * n_dot_l
}

env_brdf_approx :: proc(n_dot_v: f32, roughness: f32) -> vec2 {
	c0 := vec4(-1, -0.0275, -0.572, 0.022)
	c1 := vec4(1, 0.0425, 1.04, -0.04)
	r := roughness * c0 + c1
	a004 := min(r.x * r.x, exp2(-9.28 * n_dot_v)) * r.x + r.y
	return vec2(-1.04, 1.04) * a004 + vec2(r.z, r.w)
}

specular_ggx :: proc(n: vec3, v: vec3, l: vec3, roughness: f32, f0: vec3) -> vec3 {
	h := normalize(v + l)
	n_dot_v := max(dot(n, v), 1e-4)
	n_dot_l := max(dot(n, l), 0)
	n_dot_h := max(dot(n, h), 0)
	v_dot_h := max(dot(v, h), 0)
	d := ndf_ggx(n_dot_h, roughness)
	g := smith_ggx_correlated(n_dot_v, n_dot_l, roughness)
	f := fresnel_schlick(v_dot_h, f0)
	return d * g * f * n_dot_l
}
