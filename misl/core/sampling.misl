/*
	Texture sampling helpers.

	Bicubic: Catmull-Rom. Triplanar: GPU Gems. Equirect: spherical map. PCF: shadow
	filter textbooks. FXAA: Timothy Lottes (NVIDIA FXAA, typical shader
	port of the published filter). DoF: CoC + tap blur. Flow: offset by
	a vector field. Height-to-normal: sobel of a height map. Quilt:
	Looking Glass-style tile UV. YUV: Rec.601 decode of a sampled texel.
	Wrap/filter modes stay on s32 sampler state.
*/

import "core:color.misl"
import "core:space.misl"
import "core:math.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

sample_clamp :: proc(tex: t32_2d, samp: s32, uv: vec2) -> vec4 {
	return sample(tex, samp, clamp(uv, 0, 1))
}

catmull_rom1 :: proc(p0: f32, p1: f32, p2: f32, p3: f32, t: f32) -> f32 {
	t2 := t * t
	t3 := t2 * t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 + (-p0 + 3 * p1 - 3 * p2 + p3) * t3)
}

bicubic :: proc(tex: t32_2d, samp: s32, uv: vec2, res: vec2) -> vec4 {
	texel := 1 / res
	coord := uv * res - 0.5
	f := fract(coord)
	base := (floor(coord) - 1) * texel
	c00 := sample(tex, samp, base + vec2(0, 0) * texel)
	c10 := sample(tex, samp, base + vec2(1, 0) * texel)
	c20 := sample(tex, samp, base + vec2(2, 0) * texel)
	c30 := sample(tex, samp, base + vec2(3, 0) * texel)
	c01 := sample(tex, samp, base + vec2(0, 1) * texel)
	c11 := sample(tex, samp, base + vec2(1, 1) * texel)
	c21 := sample(tex, samp, base + vec2(2, 1) * texel)
	c31 := sample(tex, samp, base + vec2(3, 1) * texel)
	c02 := sample(tex, samp, base + vec2(0, 2) * texel)
	c12 := sample(tex, samp, base + vec2(1, 2) * texel)
	c22 := sample(tex, samp, base + vec2(2, 2) * texel)
	c32 := sample(tex, samp, base + vec2(3, 2) * texel)
	c03 := sample(tex, samp, base + vec2(0, 3) * texel)
	c13 := sample(tex, samp, base + vec2(1, 3) * texel)
	c23 := sample(tex, samp, base + vec2(2, 3) * texel)
	c33 := sample(tex, samp, base + vec2(3, 3) * texel)
	r0 := vec4(
		catmull_rom1(c00.x, c10.x, c20.x, c30.x, f.x),
		catmull_rom1(c00.y, c10.y, c20.y, c30.y, f.x),
		catmull_rom1(c00.z, c10.z, c20.z, c30.z, f.x),
		catmull_rom1(c00.w, c10.w, c20.w, c30.w, f.x),
	)
	r1 := vec4(
		catmull_rom1(c01.x, c11.x, c21.x, c31.x, f.x),
		catmull_rom1(c01.y, c11.y, c21.y, c31.y, f.x),
		catmull_rom1(c01.z, c11.z, c21.z, c31.z, f.x),
		catmull_rom1(c01.w, c11.w, c21.w, c31.w, f.x),
	)
	r2 := vec4(
		catmull_rom1(c02.x, c12.x, c22.x, c32.x, f.x),
		catmull_rom1(c02.y, c12.y, c22.y, c32.y, f.x),
		catmull_rom1(c02.z, c12.z, c22.z, c32.z, f.x),
		catmull_rom1(c02.w, c12.w, c22.w, c32.w, f.x),
	)
	r3 := vec4(
		catmull_rom1(c03.x, c13.x, c23.x, c33.x, f.x),
		catmull_rom1(c03.y, c13.y, c23.y, c33.y, f.x),
		catmull_rom1(c03.z, c13.z, c23.z, c33.z, f.x),
		catmull_rom1(c03.w, c13.w, c23.w, c33.w, f.x),
	)
	return vec4(
		catmull_rom1(r0.x, r1.x, r2.x, r3.x, f.y),
		catmull_rom1(r0.y, r1.y, r2.y, r3.y, f.y),
		catmull_rom1(r0.z, r1.z, r2.z, r3.z, f.y),
		catmull_rom1(r0.w, r1.w, r2.w, r3.w, f.y),
	)
}

sprite :: proc(tex: t32_2d, samp: s32, uv: vec2, cell: vec2, atlas_cells: vec2) -> vec4 {
	return sample(tex, samp, space.sprite_uv(uv, cell, atlas_cells))
}

triplanar :: proc(tex: t32_2d, samp: s32, p: vec3, n: vec3, scale: f32) -> vec3 {
	an := abs(n)
	w := an / max(an.x + an.y + an.z, 1e-6)
	cx := sample(tex, samp, p.yz * scale).xyz
	cy := sample(tex, samp, p.xz * scale).xyz
	cz := sample(tex, samp, p.xy * scale).xyz
	return cx * w.x + cy * w.y + cz * w.z
}

equirect :: proc(tex: t32_2d, samp: s32, dir: vec3) -> vec4 {
	return sample(tex, samp, space.equirect_from_xyz(dir))
}

pcf3 :: proc(shadow: t32_2d, samp: s32, uv: vec2, res: vec2, depth: f32) -> f32 {
	acc := 0.0
	for y := -1; y <= 1; y += 1 {
		for x := -1; x <= 1; x += 1 {
			s := sample(shadow, samp, uv + vec2(f32(x), f32(y)) / res).x
			acc += 1.0 if depth <= s + 0.002 else 0.0
		}
	}
	return acc / 9
}

fxaa :: proc(tex: t32_2d, samp: s32, uv: vec2, res: vec2) -> vec3 {
	rgb_m := sample(tex, samp, uv).xyz
	luma_m := color.luma(rgb_m)
	luma_n := color.luma(sample(tex, samp, uv + vec2(0, -1) / res).xyz)
	luma_s := color.luma(sample(tex, samp, uv + vec2(0, 1) / res).xyz)
	luma_e := color.luma(sample(tex, samp, uv + vec2(1, 0) / res).xyz)
	luma_w := color.luma(sample(tex, samp, uv + vec2(-1, 0) / res).xyz)
	luma_min := min(luma_m, min(min(luma_n, luma_s), min(luma_e, luma_w)))
	luma_max := max(luma_m, max(max(luma_n, luma_s), max(luma_e, luma_w)))
	dir := vec2(-((luma_n + luma_s) - (luma_e + luma_w)), (luma_e + luma_w) - (luma_n + luma_s))
	dir = dir / max(mag(dir), 1e-4)
	rgb_a := 0.5 * (sample(tex, samp, uv + dir / res).xyz + sample(tex, samp, uv - dir / res).xyz)
	span := luma_max - luma_min
	return rgb_m if span < 0.1 else lerp(rgb_m, rgb_a, 0.5)
}

dof :: proc(tex: t32_2d, samp: s32, uv: vec2, res: vec2, coc: f32) -> vec3 {
	acc := vec3(0, 0, 0)
	for i := 0; i < 8; i += 1 {
		a := f32(i) * 0.785398
		acc = acc + sample(tex, samp, uv + vec2(cos(a), sin(a)) * coc / res).xyz
	}
	return acc / 8
}

flow :: proc(tex: t32_2d, samp: s32, uv: vec2, vel: vec2) -> vec4 {
	return sample(tex, samp, uv + vel)
}

normal_from_height :: proc(tex: t32_2d, samp: s32, uv: vec2, res: vec2, scale: f32) -> vec3 {
	h_l := sample(tex, samp, uv + vec2(-1, 0) / res).x
	h_r := sample(tex, samp, uv + vec2(1, 0) / res).x
	h_d := sample(tex, samp, uv + vec2(0, -1) / res).x
	h_u := sample(tex, samp, uv + vec2(0, 1) / res).x
	return normalize(vec3((h_l - h_r) * scale, (h_d - h_u) * scale, 1))
}

quilt_uv :: proc(uv: vec2, view: f32, tiles: vec2) -> vec2 {
	idx := floor(view)
	col := mod(idx, tiles.x)
	row := floor(idx / tiles.x)
	return (uv + vec2(col, row)) / tiles
}

sample_yuv :: proc(tex: t32_2d, samp: s32, uv: vec2) -> vec3 {
	return color.rgb_from_yuv(sample(tex, samp, uv).xyz)
}
