vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Vertex :: struct {
	pos: vec3,
	uv:  vec2,
}

Vert_Data :: struct {
	verts: [^]Vertex,
}

VS_Out :: struct {
	pos: vec4 | SV_Position,
	uv:  vec2,
}

vs :: proc "vertex"(
	vid: u32 | SV_Vertex,
	data: ^Vert_Data | SV_Data,
) -> (out: VS_Out) {
	v := data.verts[vid]
	out.pos = vec4(v.pos, 1)
	out.uv = v.uv
	return out
}

Frag_Data :: struct {
	tex:  t32_2d,
	samp: s32,
}

linear_to_srgb :: proc(color: vec4) -> vec4 {
	cutoff := vec3(
		f32(1) if color.x < 0.0031308 else f32(0),
		f32(1) if color.y < 0.0031308 else f32(0),
		f32(1) if color.z < 0.0031308 else f32(0),
	)
	higher := vec3(1.055) * pow(color.xyz, vec3(1 / 2.4)) - vec3(0.055)
	lower := color.xyz * vec3(12.92)
	return vec4(lerp(higher, lower, cutoff), color.w)
}

filmic :: proc(x: vec3) -> vec3 {
	X := max(vec3(0), x - 0.004)
	result := (X * (6.2 * X + 0.5)) / (X * (6.2 * X + 1.7) + 0.06)
	return pow(result, vec3(2.2))
}

hdr_to_ldr :: proc(color: vec4) -> vec4 {
	return vec4(filmic(color.xyz), color.w)
}

fs :: proc "fragment"(
	input: VS_Out,
	data: ^Frag_Data | SV_Data,
) -> (out: vec4 | SV_Target) {
	linear := sample(data.tex, data.samp, input.uv)
	out = linear_to_srgb(hdr_to_ldr(max(vec4(0, 0, 0, 0), linear)))
	return out
}
