import "core:debug.misl"

vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32
mat4 :: matrix[4, 4]f32
ivec2 :: [2]i32

PI :: 3.1415

Mesh :: struct {
	pos:     [^]vec4,
	normal:  [^]vec4,
	indices: [^]u32,
}

Instance :: struct {
	mesh_idx: u32,
}

Scene :: struct {
	instances: [^]Instance,
	meshes:    [^]Mesh,
}

Data :: struct {
	output_texture:  rw32_2d,
	tlas:            bvh32,
	scene:           Scene,
	accum_counter:  u32,
	camera_to_world: mat4,
	_padding: u32, // IMPORTANT NOTE(Dragos): no_gfx needs to enable StorageBuffer8BitAccess in order for misl to support automatic padding with no validation errors. The validation error is likely a nothing burger since we don't really access the padding bytes
}

Ray :: struct {
	ori: vec3,
	dir: vec3,
}

Hit_Info :: struct {
	hit:    b32,
	t:      f32,
	normal: vec3,
}

hash_u32 :: proc(seed: u32) -> u32 {
	x := seed
	x = x ~ (x >> 17)
	x = x * 0xed5ad4bb
	x = x ~ (x >> 11)
	x = x * 0xac4c1b51
	x = x ~ (x >> 15)
	x = x * 0x31848bab
	x = x ~ (x >> 14)
	return x
}

init_rng :: proc(#ref rng: u32, global_id: u32, accum_counter: u32) {
	rng = hash_u32((global_id * 19349663) ~ (accum_counter * 83492791))
}

random_f32 :: proc(#ref rng: u32) -> f32 {
	rng *= 747796405 + 2891336453
	result := ((rng >> ((rng >> 28) + 4)) ~ rng) * 277803737
	result = (result >> 22) ~ result
	debug.printf("%v", rng)
	return f32(result) / 4294967295
}

random_vec2 :: proc(#ref rng: u32) -> vec2 {
	rnd0 := random_f32(&rng)
	rnd1 := random_f32(&rng)
	return vec2(rnd0, rnd1)
}

copysignf :: proc(magnitude: f32, sgn: f32) -> f32 {
	return magnitude if sgn > 0 else -magnitude
}

basis_fromz :: proc(v: vec3) -> mat4 {
	z := normalize(v)
	sign := copysignf(1, z.z)
	a := -1 / (sign + z.z)
	b := z.x * z.y * a
	x := vec3(1 + sign * z.x * z.x * a, sign * b, -sign * z.x)
	y := vec3(b, sign + z.y * z.y * a, -z.y)
	return mat4(
		x.x, x.y, x.z, 0,
		y.x, y.y, y.z, 0,
		z.x, z.y, z.z, 0,
		0, 0, 0, 0,
	)
}

sample_hemisphere_cos :: proc(normal: vec3, ruv: vec2) -> vec3 {
	z := sqrt(ruv.y)
	r := sqrt(1 - z * z)
	phi := 2 * PI * ruv.x
	local_direction := vec3(r * cos(phi), r * sin(phi), z)
	d := basis_fromz(normal) * vec4(local_direction, 0)
	return normalize(vec3(d.x, d.y, d.z))
}

sample_hemisphere_cos_pdf :: proc(normal: vec3, direction: vec3) -> f32 {
	cosw := dot(normal, direction)
	return 0 if cosw <= 0 else cosw / PI
}

sample_matte :: proc(color: vec3, normal: vec3, outgoing: vec3, rn: vec2) -> vec3 {
	_ = color
	_ = outgoing
	return sample_hemisphere_cos(normal, rn)
}

eval_matte :: proc(color: vec3, normal: vec3, outgoing: vec3, incoming: vec3) -> vec3 {
	_ = outgoing
	return color / PI * abs(dot(normal, incoming))
}

sample_matte_pdf :: proc(color: vec3, normal: vec3, outgoing: vec3, incoming: vec3) -> f32 {
	_ = color
	_ = outgoing
	return sample_hemisphere_cos_pdf(normal, incoming)
}

is_finite :: proc(v: vec3) -> b32 {
	is_x := (u32_from_f32_bits(v.x) & 0x7F800000) != 0x7F800000
	is_y := (u32_from_f32_bits(v.y) & 0x7F800000) != 0x7F800000
	is_z := (u32_from_f32_bits(v.z) & 0x7F800000) != 0x7F800000
	return is_x && is_y && is_z
}

ray_scene_intersection :: proc(ray: Ray, tlas_id: bvh32, scene: Scene) -> Hit_Info {
	Ray_Flags_Opaque :: 1
	Ray_Result_Kind_Hit_Mesh :: 1

	hit_info: Hit_Info
	desc: Ray_Desc
	desc.flags = {.Opaque}
	desc.cull_mask = 0xFF
	desc.t_min = 0.001
	desc.t_max = 1000000000
	desc.origin = ray.ori
	desc.dir = ray.dir
	rq := rayquery_init(desc, tlas_id)
	_ = rayquery_proceed(rq)
	hit := rayquery_result(rq)

	if hit.kind != Ray_Result_Kind_Hit_Mesh {
		hit_info.hit = false
		return hit_info
	}

	instance := scene.instances[hit.instance_idx]
	mesh := scene.meshes[instance.mesh_idx]
	base_idx := hit.primitive_idx * 3
	w := 1 - hit.barycentrics.x - hit.barycentrics.y
	n0 := mesh.normal[mesh.indices[base_idx + 0]]
	n1 := mesh.normal[mesh.indices[base_idx + 1]]
	n2 := mesh.normal[mesh.indices[base_idx + 2]]
	n := normalize(n0 * w + n1 * hit.barycentrics.x + n2 * hit.barycentrics.y)
	if hit.front_face {
		n *= -1
	}
	world_n := normalize(transpose(hit.world_to_object) * n.xyz)
	hit_info.hit = true
	hit_info.t = hit.t
	hit_info.normal = world_n.xyz
	return hit_info
}

pathtrace :: proc(#ref rng: u32, start_ray: Ray, tlas_id: bvh32, scene: Scene) -> vec3 {
	radiance := vec3(0, 0, 0)
	weight := vec3(1, 1, 1)
	ray := start_ray
	albedo_color := vec3(0.9, 0.9, 0.9)
	max_bounces := 5
	
	for bounce := 0; bounce <= max_bounces; bounce += 1 {
		hit := ray_scene_intersection(ray, tlas_id, scene)
		if !hit.hit {
			coords := vec2(atan2(ray.dir.x, ray.dir.z) / (2 * 3.1415), acos(clamp(ray.dir.y, -1, 1)) / 3.1415)
			emission := lerp(vec3(0.8, 0.7, 0.1), vec3(0.1, 0.2, 0.8), vec3(coords.y)) * 5
			radiance += emission * weight
			break
		}

		outgoing := -ray.dir
		rnd := random_vec2(&rng)
		incoming := sample_matte(albedo_color, hit.normal, outgoing, rnd)
		if incoming.x == 0 && incoming.y == 0 && incoming.z == 0 {
			break
		}

		prob := sample_matte_pdf(albedo_color, hit.normal, outgoing, incoming)
		weight *= eval_matte(albedo_color, hit.normal, outgoing, incoming) / prob

		ray.ori += ray.dir * hit.t
		ray.dir = incoming

		if weight.x == 0 && weight.y == 0 && weight.z == 0 {
			break
		}
		if is_finite(weight) == false {
			break
		}

		if bounce > 3 {
			survive_prob := min(0.99, max(weight.x, max(weight.y, weight.z)))
			if random_f32(&rng) >= survive_prob {
				break
			}
			weight /= survive_prob
		}
	}
	return radiance
}

@(size = {8, 8})
cs :: proc "compute"(
	data: ^Data | SV_Data,
	gid: [3]u32 | SV_Global_Thread,
) {
	sz := dim(data.output_texture)
	rng: u32
	init_rng(&rng, gid.y * u32(sz.x) + gid.x, data.accum_counter)

	uv := vec2(f32(gid.x), f32(gid.y)) / vec2(f32(sz.x), f32(sz.y))
	coord := 2 * uv - 1
	coord *= tan((90 * PI / 180) / 2)
	coord.y *= f32(sz.y) / f32(sz.x)

	wp := data.camera_to_world * vec4(0, 0, 0, 1)
	world_camera_pos := vec3(wp.x, wp.y, wp.z)
	camera_lookat := normalize(vec3(coord.x, coord.y, 1))
	look := data.camera_to_world * vec4(camera_lookat, 0)
	world_camera_lookat := normalize(vec3(look.x, look.y, look.z))

	camera_ray: Ray
	camera_ray.ori = world_camera_pos
	camera_ray.dir = world_camera_lookat
	color := pathtrace(&rng, camera_ray, data.tlas, data.scene)

	if gid.x < u32(sz.x) && gid.y < u32(sz.y) {
		if data.accum_counter > 1 {
			weight := 1 / f32(data.accum_counter)
			prev_color := load(data.output_texture, ivec2(i32(gid.x), i32(gid.y))).xyz
			color = prev_color * (1 - weight) + color * weight
			color = max(color, vec3(0, 0, 0))
		}
		store(data.output_texture, ivec2(i32(gid.x), i32(gid.y)), vec4(color, 1))
	}
}
