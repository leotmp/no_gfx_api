COLOR :: #inout(f32x4, 0)
UV :: #inout(f32x2, 1)

Im_Draw_Vert :: struct
{
    pos: f32x2,
    uv:  f32x2,
    col: u32,
}

Vert_Data :: struct
{
    verts: [^]Im_Draw_Vert,
    vert_offset: u32,
    scale: f32x2,
    translate: f32x2,
}

VS_Out :: struct
{
    pos:   f32x4 | SV_Position,
    color: f32x4 | COLOR,
    uv:    f32x2 | UV,
}

uint_to_rgba8 :: proc(v: u32) -> f32x4
{
    return f32x4(
        f32(v & 0xFF),
        f32((v >> 8) & 0xFF),
        f32((v >> 16) & 0xFF),
        f32((v >> 24) & 0xFF),
    ) / 255.0
}

vert :: proc "vertex"(data: ^Vert_Data | SV_Data, vert_id: u32 | SV_Vertex) -> (out: VS_Out)
{
    id := vert_id + data.vert_offset
    v := data.verts[id]
    out.color = uint_to_rgba8(v.col)
    out.pos = f32x4(v.pos * data.scale + data.translate, 0, 1)
    out.uv = v.uv
    return out
}

Frag_Data :: struct
{
    tex_id: t32_2d,
    sampler_id: s32,
}

frag :: proc "fragment"(input: VS_Out, data: ^Frag_Data | SV_Data) -> (out: f32x4 | SV_Target)
{
    out = input.color * sample(data.tex_id, data.sampler_id, input.uv)
    return out
}
