vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32
mat4 :: matrix[4, 4]f32

Vert_Data :: struct {
	positions:      [^]vec3,
	model_to_world: mat4,
	world_to_view:  mat4,
	view_to_proj:   mat4,
}

VS_Out :: struct {
	pos:       vec4 | SV_Position,
	world_pos: vec3,
}

vs :: proc "vertex"(
	vid: u32 | SV_Vertex,
	data: ^Vert_Data | SV_Data,
) -> (out: VS_Out) {
	clip_pos := vec4(data.positions[vid], 1)
	world_pos := data.model_to_world * clip_pos
	clip_pos = data.world_to_view * world_pos
	clip_pos = data.view_to_proj * clip_pos
	clip_pos.y = -clip_pos.y

	out.pos = clip_pos
	out.world_pos = world_pos.xyz
	return out
}

Frag_Data :: struct {
	cloud_texture: t32_3d,
	cloud_sampler: s32,
	camera_pos:    vec3,
}

Intersect_Result :: struct {
	hit: b32,
	t0:  f32,
	t1:  f32,
}

intersect_aabb :: proc(ro: vec3, rd: vec3, bmin: vec3, bmax: vec3) -> Intersect_Result {
	inv := 1 / rd
	tbot := (bmin - ro) * inv
	ttop := (bmax - ro) * inv
	tmin := min(ttop, tbot)
	tmax := max(ttop, tbot)
	res: Intersect_Result
	res.t0 = max(max(tmin.x, tmin.y), tmin.z)
	res.t1 = min(min(tmax.x, tmax.y), tmax.z)
	res.hit = res.t1 > max(res.t0, 0)
	return res
}

fs :: proc "fragment"(
	input: VS_Out,
	data: ^Frag_Data | SV_Data,
) -> (out: vec4 | SV_Target) {
	ray_origin := input.world_pos
	ray_dir := normalize(input.world_pos - data.camera_pos)
	bmin := vec3(-0.5, -0.5, -0.5)
	bmax := vec3(0.5, 0.5, 0.5)
	intersect_res := intersect_aabb(ray_origin, ray_dir, bmin, bmax)
	if !intersect_res.hit {
		out = vec4(0, 0, 0, 1)
		return out
	}

	t0 := max(intersect_res.t0, 0)
	t1 := intersect_res.t1
	STEPS :: 64
	step_size := (t1 - t0) / f32(STEPS)
	col := vec3(0.2)
	alpha := f32(0)
	t := t0
	for i := 0; i < STEPS; i += 1 {
		p := ray_origin + ray_dir * t
		uvw := p + 0.5
		density := sample(data.cloud_texture, data.cloud_sampler, uvw).x
		d := density * step_size * 2
		a := (1 - alpha) * d
		alpha += a
		if alpha > 0.95 {
			break
		}
		t += step_size
	}
	out = vec4(col, alpha)
	return out
}
