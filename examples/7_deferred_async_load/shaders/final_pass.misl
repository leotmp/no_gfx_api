vec2 :: [2]f32
vec3 :: [3]f32
vec4 :: [4]f32

Vertex :: struct {
	pos: vec3,
	uv:  vec2,
}

Vert_Data :: struct {
	verts: [^]Vertex,
}

VS_Out :: struct {
	pos: vec4 | SV_Position,
	uv:  vec2,
}

vs :: proc "vertex"(
	vid: u32 | SV_Vertex,
	data: ^Vert_Data | SV_Data,
) -> (out: VS_Out) {
	v := data.verts[vid]
	out.pos = vec4(v.pos, 1)
	out.uv = v.uv
	return out
}

Frag_Data :: struct {
	gbuffer_albedo:                     t32_2d,
	gbuffer_albedo_sampler:            s32,
	gbuffer_normal:                    t32_2d,
	gbuffer_normal_sampler:            s32,
	gbuffer_metallic_roughness:        t32_2d,
	gbuffer_metallic_roughness_sampler: s32,
	selected_texture_type:             i32,
}

fs :: proc "fragment"(
	input: VS_Out,
	data: ^Frag_Data | SV_Data,
) -> (out: vec4 | SV_Target) {
	uv := input.uv
	if data.selected_texture_type == 0 {
		out = sample(data.gbuffer_albedo, data.gbuffer_albedo_sampler, uv)
	} else if data.selected_texture_type == 1 {
		out = sample(data.gbuffer_normal, data.gbuffer_normal_sampler, uv)
	} else {
		out = sample(data.gbuffer_metallic_roughness, data.gbuffer_metallic_roughness_sampler, uv)
	}
	return out
}
